# Copy to .env (git-ignored). Leave empty to run in golden mode with no Azure calls.
TACTICLENS_MODE=golden
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=
AZURE_AI_SERVICES_ENDPOINT=
AZURE_CONTENT_SAFETY_ENDPOINT=
# Optional: Cosmos DB moment/evidence store (falls back to local JSON when empty or unreachable)
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=tacticlens
