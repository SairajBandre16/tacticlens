{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticlens.dev/contracts/overlay_cue.schema.json",
  "title": "OverlayCue",
  "description": "Broadcaster-style overlay instruction rendered on the replay timeline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cue_id", "match_id", "in_t", "out_t", "template", "persona_key", "lang", "payload", "a11y"],
  "properties": {
    "cue_id": {"type": "string", "minLength": 1},
    "match_id": {"type": "string", "minLength": 1},
    "in_t": {"type": "number", "minimum": 0},
    "out_t": {"type": "number", "minimum": 0},
    "template": {"enum": ["lower_third", "stat_bug", "wp_swing", "pressing_map", "player_tag"]},
    "persona_key": {"type": "string", "minLength": 1},
    "lang": {"enum": ["en", "hi", "es", "ar", "ja"]},
    "payload": {"type": "object"},
    "a11y": {"$ref": "#/$defs/A11y"}
  },
  "$defs": {
    "A11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aria_label", "speech_text"],
      "properties": {
        "aria_label": {"type": "string", "minLength": 1},
        "speech_text": {"type": "string", "minLength": 1}
      }
    }
  }
}
